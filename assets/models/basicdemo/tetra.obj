# Regular tetrahedron on the unit sphere.
# OBJ is 1-based: face "1 2 3" uses the first three `v` lines.
# Open this file in a text editor, then press 4 in the demo for the bunny.
v  0.577350  0.577350  0.577350
v  0.577350 -0.577350 -0.577350
v -0.577350  0.577350 -0.577350
v -0.577350 -0.577350  0.577350
f 1 2 3
f 1 4 2
f 1 3 4
f 2 4 3
